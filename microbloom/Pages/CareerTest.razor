@page "/career-test"
@namespace microbloom.Pages

<PageTitle>🎯 Kariyer Testi - microbloom</PageTitle>

<style>
    .test-hero {
        background: linear-gradient(135deg, #004225, #1b4332);
        padding: 4rem 2rem;
        border-radius: var(--radius-2xl);
        margin-bottom: 3rem;
        color: white;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 66, 37, 0.3);
        position: relative;
        overflow: hidden;
    }

    .test-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }

    .test-hero h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: white !important; position: relative; z-index: 1; }
    .test-hero p { font-size: 1.1rem; opacity: 0.95; color: white !important; position: relative; z-index: 1; }

    .test-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        border-radius: var(--radius-xl);
        padding: 2rem;
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
        text-align: center;
        height: 100%;
    }

    .test-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(45, 106, 79, 0.15);
    }

    .test-icon { font-size: 3rem; margin-bottom: 1rem; }
    .test-title { font-weight: 700; color: #1f2937; margin-bottom: 0.5rem; font-size: 1.2rem; }
    .test-desc { color: #6b7280; font-size: 0.9rem; margin-bottom: 1rem; }
    .test-duration { color: #2d6a4f; font-weight: 600; font-size: 0.85rem; }

    .start-btn {
        background: linear-gradient(135deg, #2d6a4f, #004225);
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .start-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(45, 106, 79, 0.4);
        color: white;
    }

    /* Test Question Styles */
    .question-container {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        max-width: 700px;
        margin: 0 auto;
    }

    .question-progress {
        height: 8px;
        background: #e2e8f0;
        border-radius: 4px;
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .question-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #2d6a4f, #004225);
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .question-number {
        color: #2d6a4f;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .question-text {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 2rem;
    }

    .option-btn {
        display: block;
        width: 100%;
        padding: 1rem 1.5rem;
        margin-bottom: 0.75rem;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        text-align: left;
        font-size: 1rem;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .option-btn:hover {
        border-color: #2d6a4f;
        background: #f5f3ff;
        transform: translateX(5px);
    }

    .option-btn.selected {
        border-color: #2d6a4f;
        background: linear-gradient(135deg, #2d6a4f, #004225);
        color: white;
    }

    /* Result Styles */
    .result-container {
        text-align: center;
        padding: 3rem;
    }

    .result-icon {
        font-size: 5rem;
        margin-bottom: 1.5rem;
    }

    .result-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .result-subtitle {
        color: #2d6a4f;
        font-weight: 600;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
    }

    .result-description {
        color: #6b7280;
        font-size: 1.1rem;
        max-width: 500px;
        margin: 0 auto 2rem;
    }

    .career-suggestions {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.5rem;
        max-width: 400px;
        margin: 0 auto;
    }

    .career-suggestions h5 {
        color: #1f2937;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .career-tag {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, #2d6a4f, #004225);
        color: white;
        border-radius: 20px;
        margin: 0.25rem;
        font-size: 0.9rem;
    }
</style>

<div class="container my-5">
    @if (!testStarted)
    {
        <div class="test-hero">
            <h1>🎯 Kariyer Testi</h1>
            <p>Kişiliğinizi analiz edin, size uygun kariyer yollarını keşfedin</p>
        </div>

        <!-- Test Türleri -->
        <h2 class="h4 mb-4"><i class="bi bi-clipboard2-check me-2"></i>Mevcut Testler</h2>
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="test-card">
                    <div class="test-icon">🧠</div>
                    <h5 class="test-title">Kişilik Analizi</h5>
                    <p class="test-desc">MBTI tabanlı kişilik testi ile güçlü ve zayıf yönlerinizi keşfedin</p>
                    <div class="test-duration"><i class="bi bi-clock me-1"></i>10 soru • 3-5 dakika</div>
                    <button class="btn start-btn" @onclick="() => StartTest(1)">Teste Başla</button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="test-card">
                    <div class="test-icon">💡</div>
                    <h5 class="test-title">İlgi Alanı Testi</h5>
                    <p class="test-desc">Holland kodları ile hangi iş alanlarına yatkın olduğunuzu bulun</p>
                    <div class="test-duration"><i class="bi bi-clock me-1"></i>10 soru • 3-5 dakika</div>
                    <button class="btn start-btn" @onclick="() => StartTest(2)">Teste Başla</button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="test-card">
                    <div class="test-icon">⚡</div>
                    <h5 class="test-title">Çalışma Stili Testi</h5>
                    <p class="test-desc">Ideal çalışma ortamınızı ve stilinizi keşfedin</p>
                    <div class="test-duration"><i class="bi bi-clock me-1"></i>10 soru • 3-5 dakika</div>
                    <button class="btn start-btn" @onclick="() => StartTest(3)">Teste Başla</button>
                </div>
            </div>
        </div>
    }
    else if (!testCompleted)
    {
        <!-- Test Soruları -->
        <div class="question-container">
            <div class="question-progress">
                <div class="question-progress-bar" style="width: @(((currentQuestionIndex + 1) * 100 / currentQuestions.Count))%"></div>
            </div>
            
            <div class="question-number">Soru @(currentQuestionIndex + 1) / @currentQuestions.Count</div>
            <div class="question-text">@currentQuestions[currentQuestionIndex].Text</div>
            
            @foreach (var option in currentQuestions[currentQuestionIndex].Options)
            {
                <button class="option-btn @(selectedOption == option.Value ? "selected" : "")" 
                        @onclick="() => SelectOption(option.Value)">
                    @option.Text
                </button>
            }
            
            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-outline-secondary" @onclick="PreviousQuestion" disabled="@(currentQuestionIndex == 0)">
                    <i class="bi bi-arrow-left me-2"></i>Önceki
                </button>
                <button class="btn start-btn" @onclick="NextQuestion" disabled="@(selectedOption == null)">
                    @(currentQuestionIndex == currentQuestions.Count - 1 ? "Sonuçları Gör" : "Sonraki") <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Sonuçlar -->
        <div class="question-container">
            <div class="result-container">
                <div class="result-icon">@resultData.Icon</div>
                <h2 class="result-title">@resultData.Title</h2>
                <div class="result-subtitle">@resultData.Subtitle</div>
                <p class="result-description">@resultData.Description</p>
                
                <div class="career-suggestions">
                    <h5><i class="bi bi-briefcase me-2"></i>Önerilen Kariyer Yolları</h5>
                    @foreach (var career in resultData.Careers)
                    {
                        <span class="career-tag">@career</span>
                    }
                </div>
                
                <div class="mt-4">
                    <button class="btn btn-outline-primary me-2" @onclick="ResetTest">
                        <i class="bi bi-arrow-repeat me-2"></i>Başka Bir Test Yap
                    </button>
                </div>
            </div>
        </div>
    }
</div>

