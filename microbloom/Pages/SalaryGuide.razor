@page "/salary-guide"
@namespace microbloom.Pages

<PageTitle>💰 Maaş Rehberi - microbloom</PageTitle>

<style>
    .salary-hero {
        background: linear-gradient(135deg, #004225, #1b4332);
        padding: 4rem 2rem;
        border-radius: var(--radius-2xl);
        margin-bottom: 3rem;
        color: white;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 66, 37, 0.3);
        position: relative;
        overflow: hidden;
    }

    .salary-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }

    .salary-hero h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: white !important; position: relative; z-index: 1; }
    .salary-hero p { font-size: 1.1rem; opacity: 0.95; color: white !important; position: relative; z-index: 1; }

    .sector-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        border-radius: var(--radius-xl);
        padding: 1.5rem;
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .sector-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .sector-icon { font-size: 2.5rem; margin-bottom: 1rem; }
    .sector-title { font-weight: 700; color: #1f2937; margin-bottom: 0.5rem; }
    .salary-range { color: #004225; font-weight: 600; font-size: 1.1rem; }
    .salary-note { color: #6b7280; font-size: 0.85rem; }

    .position-table {
        background: white;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .position-table th {
        background: linear-gradient(135deg, #004225, #1b4332);
        color: white;
        padding: 1rem;
        font-weight: 600;
    }

    .position-table td {
        padding: 1rem;
        border-bottom: 1px solid #f3f4f6;
    }

    .position-table tr:hover td {
        background: #f0fdf4;
    }

    .level-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .level-junior { background: #dbeafe; color: #1d4ed8; }
    .level-mid { background: #fef3c7; color: #d97706; }
    .level-senior { background: #dcfce7; color: #15803d; }
</style>

<div class="container my-5">
    <div class="salary-hero">
        <h1>💰 Maaş Rehberi</h1>
        <p>Türkiye'deki sektörlere ve pozisyonlara göre güncel maaş aralıkları</p>
    </div>

    <!-- Sektör Kartları -->
    <h2 class="h4 mb-4"><i class="bi bi-graph-up-arrow me-2"></i>Sektörlere Göre Maaşlar</h2>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">💻</div>
                <h5 class="sector-title">Yazılım & Teknoloji</h5>
                <div class="salary-range">25.000 - 120.000 TL</div>
                <div class="salary-note">Deneyime göre değişir</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">🏦</div>
                <h5 class="sector-title">Finans & Bankacılık</h5>
                <div class="salary-range">20.000 - 80.000 TL</div>
                <div class="salary-note">Pozisyona göre değişir</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">🏥</div>
                <h5 class="sector-title">Sağlık</h5>
                <div class="salary-range">18.000 - 100.000 TL</div>
                <div class="salary-note">Uzmanlık alanına göre</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">📈</div>
                <h5 class="sector-title">Pazarlama & Satış</h5>
                <div class="salary-range">15.000 - 60.000 TL</div>
                <div class="salary-note">Prim dahil değil</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">🏗️</div>
                <h5 class="sector-title">İnşaat & Mühendislik</h5>
                <div class="salary-range">18.000 - 70.000 TL</div>
                <div class="salary-note">Şantiye ek ödemeleri hariç</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sector-card">
                <div class="sector-icon">🎨</div>
                <h5 class="sector-title">Tasarım & Medya</h5>
                <div class="salary-range">15.000 - 50.000 TL</div>
                <div class="salary-note">Freelance hariç</div>
            </div>
        </div>
    </div>

    <!-- Detaylı Tablo -->
    <h2 class="h4 mb-4"><i class="bi bi-table me-2"></i>Yazılım Sektörü Detayları</h2>
    <div class="position-table">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Pozisyon</th>
                    <th>Seviye</th>
                    <th>Maaş Aralığı</th>
                    <th>Ortalama</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Frontend Developer</strong></td>
                    <td><span class="level-badge level-junior">Junior</span></td>
                    <td>20.000 - 35.000 TL</td>
                    <td>27.500 TL</td>
                </tr>
                <tr>
                    <td><strong>Frontend Developer</strong></td>
                    <td><span class="level-badge level-mid">Mid</span></td>
                    <td>35.000 - 55.000 TL</td>
                    <td>45.000 TL</td>
                </tr>
                <tr>
                    <td><strong>Frontend Developer</strong></td>
                    <td><span class="level-badge level-senior">Senior</span></td>
                    <td>55.000 - 90.000 TL</td>
                    <td>72.500 TL</td>
                </tr>
                <tr>
                    <td><strong>Backend Developer</strong></td>
                    <td><span class="level-badge level-junior">Junior</span></td>
                    <td>22.000 - 38.000 TL</td>
                    <td>30.000 TL</td>
                </tr>
                <tr>
                    <td><strong>Backend Developer</strong></td>
                    <td><span class="level-badge level-senior">Senior</span></td>
                    <td>60.000 - 100.000 TL</td>
                    <td>80.000 TL</td>
                </tr>
                <tr>
                    <td><strong>DevOps Engineer</strong></td>
                    <td><span class="level-badge level-mid">Mid</span></td>
                    <td>45.000 - 75.000 TL</td>
                    <td>60.000 TL</td>
                </tr>
                <tr>
                    <td><strong>Data Scientist</strong></td>
                    <td><span class="level-badge level-mid">Mid</span></td>
                    <td>50.000 - 85.000 TL</td>
                    <td>67.500 TL</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="alert alert-info mt-4 border-0" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>Not:</strong> Bu veriler 2024 yılı için tahmini değerlerdir ve şirket büyüklüğü, lokasyon ve sektöre göre değişiklik gösterebilir.
    </div>
</div>
