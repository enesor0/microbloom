@page "/mentor-applications"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using microbloom.Services.Interfaces
@using microbloom.Entities
@attribute [Authorize(Roles = "Mentor")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService UserService

<PageTitle>Mentorluk Başvuruları - microbloom</PageTitle>

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="fw-bold mb-1">Mentorluk Başvuruları</h1>
                    <p class="text-muted mb-0">Sizden mentorluk almak isteyen adayları buradan yönetebilirsiniz.</p>
                </div>
                <a href="/mentor-dashboard" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-2"></i>Panele Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">0</h3>
                        <small class="text-muted">Bekleyen</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">0</h3>
                        <small class="text-muted">Onaylanan</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">0</h3>
                        <small class="text-muted">Reddedilen</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Applications List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0">Tüm Başvurular</h5>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active">Tümü</button>
                    <button type="button" class="btn btn-outline-secondary">Bekleyen</button>
                    <button type="button" class="btn btn-outline-secondary">Onaylanan</button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-inbox fs-1 text-muted opacity-50"></i>
                </div>
                <h5 class="fw-bold text-muted">Henüz başvuru yok</h5>
                <p class="text-muted small mb-3">
                    Profiliniz görüntülendikçe mentorluk talepleri burada görünecektir.
                </p>
                <a href="/mentorship" class="btn btn-sm btn-primary rounded-pill">
                    <i class="bi bi-eye me-1"></i> Mentor Listesinde Görün
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card {
        border-radius: 16px;
    }

    .card-header {
        border-radius: 16px 16px 0 0 !important;
    }
</style>
