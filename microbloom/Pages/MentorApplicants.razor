@page "/mentor-applications"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using microbloom.Services.Interfaces
@using microbloom.Entities
@attribute [Authorize(Roles = "Mentor")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService UserService

<PageTitle>Mentorluk Başvuruları - microbloom</PageTitle>

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="fw-bold mb-1">Mentorluk Başvuruları</h1>
                    <p class="text-muted mb-0">Sizden mentorluk almak isteyen adayları buradan yönetebilirsiniz.</p>
                </div>
                <a href="/mentor-dashboard" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-2"></i>Panele Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@pendingCount</h3>
                        <small class="text-muted">Bekleyen</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@approvedCount</h3>
                        <small class="text-muted">Onaylanan</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@rejectedCount</h3>
                        <small class="text-muted">Reddedilen</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Applications List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0">Tüm Başvurular</h5>
                <!-- Filter buttons can be implemented later with in-memory filtering -->
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active">Tümü</button>
                    <!-- Future: Filter logic -->
                </div>
            </div>
        </div>
        <div class="card-body p-0">
             @if (!string.IsNullOrEmpty(errorMessage))
             {
                 <div class="alert alert-danger m-3" role="alert">
                     <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                 </div>
             }
             else if (applications == null)
             {
                 <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
             }
             else if (applications.Count == 0)
             {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox fs-1 text-muted opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-muted">Henüz başvuru yok</h5>
                    <p class="text-muted small mb-3">
                        Profiliniz görüntülendikçe mentorluk talepleri burada görünecektir.
                    </p>
                    <a href="/mentorship" class="btn btn-sm btn-primary rounded-pill">
                        <i class="bi bi-eye me-1"></i> Mentor Listesinde Görün
                    </a>
                </div>
             }
             else
             {
                 <div class="list-group list-group-flush">
                     @foreach (var app in applications)
                     {
                         <div class="list-group-item p-4">
                             <div class="d-flex justify-content-between align-items-start">
                                 <div class="d-flex gap-3">
                                    <div class="avatar-box">
                                        @if (!string.IsNullOrEmpty(app.MenteePhotoUrl))
                                        {
                                            <img src="@app.MenteePhotoUrl" class="rounded-circle" width="50" height="50" style="object-fit:cover" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary" style="width:50px; height:50px; font-weight:bold; font-size:1.2rem;">
                                                @app.MenteeName[0]
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1">@app.MenteeName</h5>
                                        <div class="mb-2">
                                            <span class="badge @GetStatusBadge(app.Status)">@GetStatusText(app.Status)</span>
                                            <small class="text-muted ms-2">@app.RequestDate.ToString("dd MMM yyyy")</small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(app.Note))
                                        {
                                            <div class="bg-light p-3 rounded-3 mb-2">
                                                <small class="text-muted d-block mb-1">Adayın Notu:</small>
                                                <p class="mb-0 text-dark small">@app.Note</p>
                                            </div>
                                        }
                                    </div>
                                 </div>
                                 <div class="d-flex flex-column gap-2">
                                     @if (app.Status == "Pending")
                                     {
                                         <button class="btn btn-sm btn-success rounded-pill" @onclick="() => UpdateStatus(app.Id, MentorshipStatus.Approved)">
                                             <i class="bi bi-check-lg me-1"></i>Onayla
                                         </button>
                                         <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => UpdateStatus(app.Id, MentorshipStatus.Rejected)">
                                             <i class="bi bi-x-lg me-1"></i>Reddet
                                         </button>
                                     }
                                     <a href="/messages/@app.MenteeId" class="btn btn-sm btn-outline-primary rounded-pill">
                                         <i class="bi bi-chat-dots me-1"></i>Mesaj
                                     </a>
                                 </div>
                             </div>
                         </div>
                     }
                 </div>
             }
        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card {
        border-radius: 16px;
    }

    .card-header {
        border-radius: 16px 16px 0 0 !important;
    }
</style>

@inject IMentorshipService MentorshipService
@inject IJSRuntime JS

@code {
    private List<MentorshipApplicationDto>? applications;
    private string? errorMessage;
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int rejectedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                applications = await MentorshipService.GetApplicationsForMentorAsync(userId);
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Başvurular yüklenirken bir hata oluştu. Lütfen daha sonra tekrar deneyiniz.";
            Console.WriteLine($"Error loading applications: {ex.Message}");
        }
    }

    private void CalculateStats()
    {
        if (applications == null) return;
        pendingCount = applications.Count(a => a.Status == "Pending");
        approvedCount = applications.Count(a => a.Status == "Approved");
        rejectedCount = applications.Count(a => a.Status == "Rejected");
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning bg-opacity-10 text-warning",
            "Approved" => "bg-success bg-opacity-10 text-success",
            "Rejected" => "bg-danger bg-opacity-10 text-danger",
            _ => "bg-secondary"
        };
    }

      private string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "Bekliyor",
            "Approved" => "Onaylandı",
            "Rejected" => "Reddedildi",
            _ => status
        };
    }

    private async Task UpdateStatus(int appId, MentorshipStatus status)
    {
        var result = await MentorshipService.UpdateStatusAsync(appId, status);
        if (result)
        {
            await LoadApplications(); // Reload list to update UI and stats
            await JS.InvokeVoidAsync("alert", $"Başvuru durumu güncellendi: {status}");
        }
        else
        {
             await JS.InvokeVoidAsync("alert", "İşlem sırasında bir hata oluştu.");
        }
    }
}
