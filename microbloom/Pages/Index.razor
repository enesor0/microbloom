@namespace microbloom.Pages
@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using microbloom.Entities
@using microbloom.Services.Interfaces
@inject ICompanyService CompanyService
@inject UserManager<AppUser> UserManager

<PageTitle>🏠 Ana Sayfa - microbloom</PageTitle>

<AuthorizeView>
    <Authorized>
        <!-- AUTHENTICATED USER VIEW -->
        <section class="home-hero home-hero-auth">
            <div class="hero-bg-aurora"></div>
            
            <div class="container position-relative" style="z-index: 10;">
                <div class="row justify-content-center py-5">
                    <div class="col-lg-8 text-center">
                        <div class="welcome-card">
                            <div class="welcome-avatar">
                                <span>👋</span>
                            </div>
                            <h1 class="welcome-title">
                                Tekrar Hoş Geldin, <span class="gradient-text">@context.User.Identity?.Name</span>!
                            </h1>
                            <p class="welcome-subtitle">
                                Bugün hangi fırsatları keşfetmek istersin?
                            </p>
                            <div class="d-flex gap-3 justify-content-center flex-wrap">
                                <a class="hero-btn hero-btn-primary" href="/jobs">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5zm1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0zM1.5 4h13a.5.5 0 0 1 .5.5v1.616l-6.614 1.764a.5.5 0 0 1-.258.006L1.5 6.116V4.5a.5.5 0 0 1 .5-.5z"/>
                                    </svg>
                                    <span>İlanları Keşfet</span>
                                </a>
                                <a class="hero-btn hero-btn-secondary" href="/guide">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                                    </svg>
                                    <span>Kariyer Rehberi</span>
                                </a>
                                @if (context.User.IsInRole("Employer"))
                                {
                                    <a class="hero-btn hero-btn-accent" href="/company-dashboard">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zM7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zM4.5 8a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1z"/>
                                            <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3V1z"/>
                                        </svg>
                                        <span>Şirket Paneli</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Stats forAuthenticated Users -->
        <section class="py-5">
            <div class="container">
                <div class="row g-4">
                    @if (isEmployer) 
                    {
                        <!-- COMPANY STATS -->
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zM7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">@activeJobsCount Aktif İlan</h5>
                                <p class="stat-desc">Yayında olan iş ilanlarınız</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">@totalApplicationsCount Başvuru</h5>
                                <p class="stat-desc">Değerlendirilmeyi bekleyen adaylar</p>
                                <a href="/view-applications" class="stat-link">Başvuruları Gör →</a>
                            </div>
                        </div>
                         <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Mesajlar</h5>
                                <p class="stat-desc">Adaylardan gelen sorular</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Şirket Profili</h5>
                                <p class="stat-desc">Profil doluluk oranı %85</p>
                                <a href="/company/profile/edit" class="stat-link">Düzenle →</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- JOB SEEKER STATS -->
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 5.383l4.708 2.825L1 11.105V5.383z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Kariyer Takibi</h5>
                                <p class="stat-desc">Başvuru süreçlerini anlık takip et</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Hedefli Arama</h5>
                                <p class="stat-desc">Sana özel pozisyonları filtrele</p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Kariyer Rehberi</h5>
                                <p class="stat-desc">Profesyonel ipuçları ve rehberler</p>
                                <a href="/guide" class="stat-link">Keşfet →</a>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="stat-card">
                                <div class="stat-icon stat-icon-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                                    </svg>
                                </div>
                                <h5 class="stat-title">Hızlı Sonuç</h5>
                                <p class="stat-desc">Anında geri dönüşler al</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </Authorized>

    <NotAuthorized>
        <!-- GUEST HERO -->
        <section class="home-hero">
            <div class="hero-bg-aurora"></div>
            
            <div class="container position-relative" style="z-index: 10;">
                <div class="row justify-content-center align-items-center min-vh-80 py-5">
                    <div class="col-lg-10 col-xl-8 text-center">
                        <div class="hero-card">
                            <!-- Logo -->
                            <div class="mb-4">
                                <img src="/images/logo.svg" alt="microbloom" style="width: 240px; height: 240px; object-fit: contain; aspect-ratio: 1/1;" />
                            </div>
                            
                            <!-- Badge -->
                            <div class="hero-badge">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                                </svg>
                                <span>Türkiye'nin Yeni Nesil Kariyer Platformu</span>
                            </div>
                            
                            <!-- Title -->
                            <h1 class="hero-title">
                                Hayalindeki Kariyere
                                <br/>
                                <span class="gradient-text-light">Bir Adım Daha Yakınsın</span>
                            </h1>
                            
                            <!-- Subtitle -->
                            <p class="hero-subtitle">
                                Binlerce şirket, on binlerce fırsat.
                                <br class="d-none d-md-block"/>
                                Senin için en uygun işi bulmak artık çok kolay.
                            </p>
                            
                            <!-- CTA Buttons -->
                            <div class="d-flex gap-3 justify-content-center flex-column flex-sm-row mb-4">
                                <a class="hero-btn hero-btn-primary" href="/account/register">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                    </svg>
                                    <span>Ücretsiz Başla</span>
                                </a>
                                <a class="hero-btn hero-btn-ghost" href="/account/login">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                                    </svg>
                                    <span>Giriş Yap</span>
                                </a>
                            </div>
                            
                            <!-- Social Proof -->
                            <div class="social-proof">
                                <div class="avatar-stack">
                                    <div class="avatar-item">👩‍💼</div>
                                    <div class="avatar-item">👨‍💻</div>
                                    <div class="avatar-item">👩‍🔬</div>
                                    <div class="avatar-item">👨‍🎨</div>
                                </div>
                                <span class="proof-text">
                                    <strong>10,000+</strong> mutlu kullanıcı ile birlikte ol
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="py-5 my-4">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-badge">Özellikler</span>
                    <h2 class="section-title">Neden <span class="gradient-text">microbloom</span>?</h2>
                    <p class="section-subtitle">Kariyerinde fark yaratacak profesyonel özellikler</p>
                </div>
                
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="feature-card">
                            <div class="feature-icon feature-icon-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                            </div>
                            <h5 class="feature-title">Akıllı Arama</h5>
                            <p class="feature-desc">Binlerce ilan arasından sana en uygun olanı bul</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="feature-card">
                            <div class="feature-icon feature-icon-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                                </svg>
                            </div>
                            <h5 class="feature-title">Tek Tıkla Başvuru</h5>
                            <p class="feature-desc">Hızlı ve kolay başvuru süreci</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="feature-card">
                            <div class="feature-icon feature-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5 8.186 1.113zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464L7.443.184z"/>
                                </svg>
                            </div>
                            <h5 class="feature-title">Kişisel Eşleşme</h5>
                            <p class="feature-desc">Yeteneklerine göre iş önerileri</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="feature-card">
                            <div class="feature-icon feature-icon-4">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687z"/>
                                </svg>
                            </div>
                            <h5 class="feature-title">Kariyer Rehberi</h5>
                            <p class="feature-desc">CV, mülakat ve daha fazlası</p>
                            <a href="/guide" class="feature-link">Keşfet →</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card">
                    <div class="row align-items-center">
                        <div class="col-lg-7 mb-4 mb-lg-0">
                            <h2 class="cta-title">Geleceğin Bugün Başlasın!</h2>
                            <p class="cta-subtitle">
                                Ücretsiz hesap oluştur, hayalindeki işe bir adım daha yaklaş.
                            </p>
                            <ul class="cta-list">
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.146-6.147a.5.5 0 0 1 .708 0z"/>
                                    </svg>
                                    <span>Tamamen ücretsiz</span>
                                </li>
