@code {
    private int activeJobsCount = 0;
    private int totalApplicationsCount = 0;
    private bool isEmployer = false;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                isEmployer = user.IsInRole("Employer");
                if (isEmployer)
                {
                    try
                    {
                        var appUser = await UserManager.GetUserAsync(user);
                        if (appUser != null && appUser.CompanyId.HasValue)
                        {
                            var jobs = await CompanyService.GetJobsByCompanyAsync(appUser.CompanyId.Value);
                            activeJobsCount = jobs.Count;
                            
                            // Calculate total applications
                            foreach(var job in jobs)
                            {
                                var apps = await CompanyService.GetApplicationsForJobAsync(job.Id);
                                totalApplicationsCount += apps.Count;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error fetching company stats: {ex.Message}");
                    }
                }
            }
        }
    }
}
