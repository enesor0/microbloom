@namespace microbloom.Pages
@page "/company-dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Employer")]

@using microbloom.DTOs
@using microbloom.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@using microbloom.Entities
@using Microsoft.AspNetCore.Components.Authorization

@inject ICompanyService CompanyService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager
@inject IJSRuntime JSRuntime

<PageTitle>🏢 Şirket Paneli - microbloom</PageTitle>

<div class="company-dashboard-page">
    <div class="container py-5">
        <!-- Header Section -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4 mb-5">
            <div>
                <h1 class="h2 fw-bold mb-2">Şirket Paneli</h1>
                <p class="text-muted mb-0">İlanlarınızı yönetin, başvuruları takip edin ve profilinizi güncelleyin.</p>
            </div>
            <button class="btn btn-primary btn-lg btn-aurora-glow" @onclick="GoToCreateJobPage">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Yeni İlan Oluştur
            </button>
        </div>

        <div class="row g-4 mb-5">
            <!-- Left Column: Stats & Profile View -->
            <div class="col-lg-4">
                <div class="glass-card h-100 p-4">
                    @if (isProfileLoading)
                    {
                        <div class="text-center py-5">
                            <div class="loading-spinner mb-3"></div>
                            <p class="text-muted">Profil yükleniyor...</p>
                        </div>
                    }
                    else if (companyProfile != null)
                    {
                        <div class="text-center mb-4">
                            <div class="profile-logo-wrapper mb-3">
                                @if (!string.IsNullOrWhiteSpace(companyProfile.LogoUrl))
                                {
                                    <img src="@companyProfile.LogoUrl" class="profile-logo" alt="Logo" />
                                }
                                else
                                {
                                    <span class="profile-logo-placeholder">🏢</span>
                                }
                            </div>
                            <h3 class="h5 fw-bold mb-1">@(!string.IsNullOrWhiteSpace(companyProfile.Name) ? companyProfile.Name : "Şirket Adı Yok")</h3>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">İşveren Hesabı</span>
                        </div>

                        <div class="stats-grid mb-4">
                            <div class="stat-item">
                                <span class="stat-value">@companyProfile.ActiveJobCount</span>
                                <span class="stat-label">Aktif İlan</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-value">@companyProfile.EmployeeCount</span>
                                <span class="stat-label">Çalışan</span>
                            </div>
                        </div>

                        <div class="p-3 bg-light-subtle rounded border border-light-subtle mb-3">
                            <p class="small text-muted mb-0 text-center" style="line-height: 1.6;">
                                @(!string.IsNullOrWhiteSpace(companyProfile.Description)
                                    ? (companyProfile.Description.Length > 100 ? companyProfile.Description.Substring(0, 100) + "..." : companyProfile.Description)
                                    : "Henüz şirket açıklaması girilmemiş.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">Profil yüklenemedi.</div>
                    }
                </div>
            </div>

            <!-- Right Column: Company Details View -->
            <div class="col-lg-8">
                <div class="glass-card h-100 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="card-header-clean">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2 text-primary" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/>
                            </svg>
                            <h3 class="h5 fw-bold mb-0">Şirket Detayları</h3>
                        </div>
                        <a href="/company/profile/edit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-pencil-square me-2"></i>Profili Düzenle
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(profileStatusMessage))
                    {
                        <div class="alert alert-info mb-4" role="alert">
                            @profileStatusMessage
                        </div>
                    }

                    @if (!isProfileLoading && companyProfile != null)
                    {
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3 bg-light-subtle rounded border border-light-subtle h-100">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Temel Bilgiler</h6>
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2"><span class="fw-medium text-dark">Sektör:</span> @(string.IsNullOrEmpty(companyProfile.Industry) ? "-" : companyProfile.Industry)</li>
                                        <li class="mb-2"><span class="fw-medium text-dark">Çalışan Sayısı:</span> @(string.IsNullOrEmpty(companyProfile.EmployeeCount) ? "-" : companyProfile.EmployeeCount)</li>
                                        <li class="mb-2"><span class="fw-medium text-dark">Kuruluş Yılı:</span> @(companyProfile.FoundedYear.HasValue ? companyProfile.FoundedYear : "-")</li>
                                        <li><span class="fw-medium text-dark">Lokasyon:</span> @(string.IsNullOrEmpty(companyProfile.Location) ? "-" : companyProfile.Location)</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light-subtle rounded border border-light-subtle h-100">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-3">İletişim & Web</h6>
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2">
                                            <i class="bi bi-globe me-2 text-primary"></i>
                                            @if(!string.IsNullOrEmpty(companyProfile.Website)) { <a href="@companyProfile.Website" target="_blank">Web Sitesi</a> } else { <span>-</span> }
                                        </li>
                                        <li class="mb-2">
                                            <i class="bi bi-linkedin me-2 text-primary"></i>
                                            @if(!string.IsNullOrEmpty(companyProfile.LinkedInUrl)) { <a href="@companyProfile.LinkedInUrl" target="_blank">LinkedIn</a> } else { <span>-</span> }
                                        </li>
                                        <li class="mb-2">
                                           <i class="bi bi-envelope me-2 text-primary"></i>
                                            @(string.IsNullOrEmpty(companyProfile.ContactEmail) ? "-" : companyProfile.ContactEmail)
                                        </li>
                                         <li>
                                           <i class="bi bi-telephone me-2 text-primary"></i>
                                            @(string.IsNullOrEmpty(companyProfile.Phone) ? "-" : companyProfile.Phone)
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Job Listings -->
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="h5 fw-bold mb-0">📋 Aktif İlanlarım</h3>
                <span class="badge bg-primary rounded-pill px-3">@(myJobs?.Count ?? 0) İlan</span>
            </div>

            @if (myJobs == null)
            {
                <div class="text-center py-5">
                    <div class="loading-spinner mb-3"></div>
                    <p class="text-muted">İlanlarınız yükleniyor...</p>
                </div>
            }
            else if (!myJobs.Any())
            {
                <div class="text-center py-5">
                    <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">📭</div>
                    <h5 class="text-muted">Henüz hiç ilan oluşturmadınız.</h5>
                    <button class="btn btn-primary mt-3" @onclick="GoToCreateJobPage">
                        İlk İlanı Oluştur
                    </button>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var job in myJobs)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="job-manage-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-3">
                                        <h5 class="job-title mb-0">@job.Title</h5>
                                        @if(job.IsActive)
                                        {
                                            <span class="status-badge active">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge passive">Pasif</span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                                            <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"/>
                                            <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                        </svg>
                                        @job.Location
                                    </p>

                                    <div class="job-actions">
                                        <button class="btn btn-action primary" @onclick="() => ViewApplications(job.Id)" title="Başvuruları Gör">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                                <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
                                                <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                                            </svg>
                                            Başvurular
                                        </button>
                                        <button class="btn btn-action warning" @onclick="() => ToggleJobStatus(job)" disabled="@isProcessing" title="@(job.IsActive ? "Pasife Al" : "Aktife Al")">
                                            @if (isProcessing && processingJobId == job.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                if(job.IsActive) { 
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M5 6.25a1.25 1.25 0 1 1 2.5 0v3.5a1.25 1.25 0 1 1-2.5 0v-3.5zm3.5 0a1.25 1.25 0 1 1 2.5 0v3.5a1.25 1.25 0 1 1-2.5 0v-3.5z"/></svg> 
                                                }
                                                else { 
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814l-3.5-2.5z"/></svg> 
                                                }
                                            }
                                        </button>
                                        <button class="btn btn-action danger" @onclick="() => DeleteJob(job.Id)" disabled="@isProcessing" title="Sil">
                                            @if (isProcessing && processingJobId == job.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-primary);
        border-radius: 1.5rem;
    }

    [data-theme="dark"] .glass-card {
        background: rgba(30, 41, 59, 0.6);
        border-color: rgba(71, 85, 105, 0.4);
    }

    .profile-logo-wrapper {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        background: var(--bg-secondary);
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--border-primary);
        overflow: hidden;
    }

    .profile-logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .profile-logo-placeholder {
        font-size: 2rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .stat-item {
        background: var(--bg-secondary);
        padding: 1rem;
        border-radius: 1rem;
        text-align: center;
        border: 1px solid var(--border-primary);
    }

    .stat-value {
        display: block;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--aurora-primary);
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .form-floating > .form-control {
        background: var(--bg-secondary) !important;
        border: 1px solid var(--border-primary) !important;
        border-radius: 0.75rem !important;
    }
    
    .form-floating > .form-control:focus {
        border-color: var(--aurora-primary) !important;
        box-shadow: 0 0 0 3px rgba(0, 66, 37, 0.15) !important;
    }

    /* Job Manager Cards */
    .job-manage-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-primary);
        border-radius: 1rem;
        transition: all 0.2s ease;
    }
    
    .job-manage-card:hover {
        transform: translateY(-2px);
        border-color: var(--aurora-primary);
    }

    .job-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-primary);
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-weight: 600;
    }
    
    .status-badge.active { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .status-badge.passive { background: rgba(100, 116, 139, 0.1); color: #64748b; }

    .job-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: auto;
    }

    .btn-action {
        flex: 1;
        border: none;
        padding: 0.5rem;
        border-radius: 0.5rem;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        transition: all 0.2s ease;
    }

    .btn-action.primary { background: rgba(0, 66, 37, 0.1); color: var(--aurora-primary); }
    .btn-action.primary:hover { background: var(--aurora-primary); color: white; }

    .btn-action.warning { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .btn-action.warning:hover { background: #f59e0b; color: white; }

    .btn-action.danger { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .btn-action.danger:hover { background: #ef4444; color: white; }
    
    .btn-aurora-glow {
        box-shadow: 0 4px 15px rgba(0, 66, 37, 0.4); 
    }
    
    .loading-spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--border-primary);
        border-top-color: var(--aurora-primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }
    
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<JobPostingDto>? myJobs;
    private CompanyProfileDto companyProfile = new();
    private bool isProfileLoading = true;
    private string profileStatusMessage = string.Empty;
    private bool isProcessing;
    private int? processingJobId;
    
    private int? currentCompanyId;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDataAsync();
        if(currentCompanyId.HasValue)
        {
            await LoadCompanyProfileAsync();
            await LoadCompanyJobsAsync();
        }
        else
        {
            isProfileLoading = false;
            profileStatusMessage = "Şirket profiline erişim yetkiniz yok.";
        }
    }

    private async Task LoadUserDataAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if(user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            currentCompanyId = appUser?.CompanyId;
        }
    }

    private async Task LoadCompanyProfileAsync()
    {
        if(!currentCompanyId.HasValue) return;

        try
        {
            isProfileLoading = true;
            profileStatusMessage = string.Empty;

            var profile = await CompanyService.GetCompanyProfileAsync(currentCompanyId.Value);
            companyProfile = profile ?? new CompanyProfileDto();
        }
        catch (Exception ex)
        {
            companyProfile = new CompanyProfileDto();
            profileStatusMessage = "Şirket profili yüklenemedi.";
        }
        finally
        {
            isProfileLoading = false;
        }
    }

    private async Task LoadCompanyJobsAsync()
    {
        if(!currentCompanyId.HasValue) return;

        try
        {
            myJobs = await CompanyService.GetJobsByCompanyAsync(currentCompanyId.Value);
        }
        catch (Exception ex)
        {
            myJobs = new List<JobPostingDto>();
        }
    }

    private void ViewApplications(int jobId)
    {
        NavigationManager.NavigateTo($"/company/job/{jobId}/applications");
    }

    private void GoToCreateJobPage()
    {
        NavigationManager.NavigateTo("/company/create-job");
    }

    private async Task ToggleJobStatus(JobPostingDto job)
    {
        if(!currentCompanyId.HasValue) return;

        string actionText = job.IsActive ? "pasif" : "aktif";
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Bu ilanı {actionText} yapmak istediğinizden emin misiniz?"))
            return;

        try
        {
            isProcessing = true;
            processingJobId = job.Id;
            StateHasChanged();

            await CompanyService.ToggleJobStatusAsync(job.Id, !job.IsActive, currentCompanyId.Value);

            await LoadCompanyJobsAsync();
            await LoadCompanyProfileAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"İlan durumu değiştirilemedi: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            processingJobId = null;
            StateHasChanged();
        }
    }

    private async Task DeleteJob(int jobId)
    {
        if(!currentCompanyId.HasValue) return;

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Bu ilanı kalıcı olarak silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!"))
            return;

        try
        {
            isProcessing = true;
            processingJobId = jobId;
            StateHasChanged();

            await CompanyService.DeleteJobPostingAsync(jobId, currentCompanyId.Value);

            await LoadCompanyJobsAsync();
            await LoadCompanyProfileAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hata: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            processingJobId = null;
            StateHasChanged();
        }
    }
}
