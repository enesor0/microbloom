@page "/mentorship"
@namespace microbloom.Pages

<PageTitle>🤝 Mentorluk - microbloom</PageTitle>

<style>
    .mentor-hero {
        background: linear-gradient(135deg, #004225, #1b4332);
        padding: 4rem 2rem;
        border-radius: var(--radius-2xl);
        margin-bottom: 3rem;
        color: white;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 66, 37, 0.3);
        position: relative;
        overflow: hidden;
    }

    .mentor-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }

    .mentor-hero h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: white !important; position: relative; z-index: 1; }
    .mentor-hero p { color: white !important; opacity: 0.95; position: relative; z-index: 1; }

    .mentor-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        height: 100%;
    }

    .mentor-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 66, 37, 0.15);
    }

    .mentor-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #004225, #1b4332);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        margin: 0 auto 1rem;
    }

    .mentor-name { font-weight: 700; color: #1f2937; text-align: center; }
    .mentor-title { color: #6b7280; font-size: 0.9rem; text-align: center; margin-bottom: 1rem; }
    .mentor-company { color: #004225; font-weight: 600; font-size: 0.85rem; text-align: center; }

    .skill-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #d8f3dc;
        color: #1b4332;
        border-radius: 20px;
        font-size: 0.75rem;
        margin: 0.25rem;
    }

    .connect-btn {
        background: linear-gradient(135deg, #004225, #1b4332);
        color: white;
        border: none;
        padding: 0.5rem 1.5rem;
        border-radius: 25px;
        font-weight: 600;
        width: 100%;
        margin-top: 1rem;
        transition: all 0.3s ease;
    }

    .connect-btn:hover {
        transform: scale(1.02);
        box-shadow: 0 8px 20px rgba(0, 66, 37, 0.4);
        color: white;
    }

    .benefit-card {
        background: var(--glass-bg);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        height: 100%;
    }

    .benefit-icon { font-size: 2.5rem; margin-bottom: 1rem; }
    .benefit-title { font-weight: 700; color: #1f2937; margin-bottom: 0.5rem; }
    .benefit-desc { color: #6b7280; font-size: 0.9rem; }
</style>

<div class="container my-5">
    <div class="mentor-hero">
        <h1>🤝 Mentorluk Programı</h1>
        <p>Deneyimli profesyonellerle kariyer yolculuğunuzda rehberlik alın</p>
    </div>

    <!-- Faydalar -->
    <h2 class="h4 mb-4"><i class="bi bi-stars me-2"></i>Mentorluk Neden Önemli?</h2>
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="benefit-card">
                <div class="benefit-icon">🎯</div>
                <h5 class="benefit-title">Kariyer Yönlendirmesi</h5>
                <p class="benefit-desc">Doğru kariyer kararları almanızda yardım</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="benefit-card">
                <div class="benefit-icon">🌐</div>
                <h5 class="benefit-title">Network Genişletme</h5>
                <p class="benefit-desc">Sektördeki önemli kişilerle tanışma</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="benefit-card">
                <div class="benefit-icon">📚</div>
                <h5 class="benefit-title">Bilgi Transferi</h5>
                <p class="benefit-desc">Yılların deneyiminden faydalanma</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="benefit-card">
                <div class="benefit-icon">💪</div>
                <h5 class="benefit-title">Motivasyon</h5>
                <p class="benefit-desc">Zor zamanlarda destek ve ilham</p>
            </div>
        </div>
    </div>

    <!-- Mentorlar -->
    <h2 class="h4 mb-4"><i class="bi bi-people me-2"></i>Öne Çıkan Mentorlar</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="mentor-card">
                <div class="mentor-avatar">👨‍💻</div>
                <h5 class="mentor-name">Ahmet Yılmaz</h5>
                <p class="mentor-title">Senior Software Engineer</p>
                <p class="mentor-company">Microsoft</p>
                <div class="text-center">
                    <span class="skill-tag">React</span>
                    <span class="skill-tag">.NET</span>
                    <span class="skill-tag">Azure</span>
                </div>
                <button class="btn connect-btn">Bağlantı Kur</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mentor-card">
                <div class="mentor-avatar">👩‍💼</div>
                <h5 class="mentor-name">Elif Kaya</h5>
                <p class="mentor-title">Product Manager</p>
                <p class="mentor-company">Google</p>
                <div class="text-center">
                    <span class="skill-tag">Product</span>
                    <span class="skill-tag">UX</span>
                    <span class="skill-tag">Agile</span>
                </div>
                <button class="btn connect-btn">Bağlantı Kur</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mentor-card">
                <div class="mentor-avatar">👨‍🔬</div>
                <h5 class="mentor-name">Mehmet Demir</h5>
                <p class="mentor-title">Data Scientist</p>
                <p class="mentor-company">Meta</p>
                <div class="text-center">
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">ML</span>
                    <span class="skill-tag">AI</span>
                </div>
                <button class="btn connect-btn">Bağlantı Kur</button>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-5 border-0" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>Mentor olmak mı istiyorsunuz?</strong> Deneyimlerinizi paylaşın ve genç profesyonellere yol gösterin!
        <a href="#" class="alert-link ms-2">Başvur →</a>
    </div>
</div>
