@page "/account/forgot-password"
@namespace microbloom.Pages.Account
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>🔐 Şifre Sıfırla - microbloom</PageTitle>

<style>
    .reset-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0fdf4 0%, #d8f3dc 50%, #b7e4c7 100%);
        padding: 2rem;
    }

    .reset-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 66, 37, 0.15);
        padding: 3rem;
        width: 100%;
        max-width: 450px;
    }

    .reset-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .reset-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #004225, #1b4332);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 2rem;
    }

    .reset-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .reset-subtitle {
        color: #6b7280;
        font-size: 0.95rem;
    }

    .form-control {
        border-radius: 12px;
        padding: 0.875rem 1rem;
        border: 2px solid #e5e7eb;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #004225;
        box-shadow: 0 0 0 4px rgba(0, 66, 37, 0.1);
    }

    .btn-reset {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #004225, #1b4332);
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .btn-reset:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 66, 37, 0.3);
    }

    .btn-reset:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .alert-success {
        background: #dcfce7;
        border: 1px solid #86efac;
        color: #166534;
        border-radius: 12px;
        padding: 1rem;
    }

    .alert-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 12px;
        padding: 1rem;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 1.5rem;
        color: #004225;
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

<div class="reset-container">
    <div class="reset-card">
        <div class="reset-header">
            <div class="reset-icon">🔐</div>
            <h1 class="reset-title">Şifre Sıfırla</h1>
            <p class="reset-subtitle">Email adresinizi girin ve yeni şifrenizi belirleyin</p>
        </div>

        @if (isSuccess)
        {
            <div class="alert alert-success">
                <strong>✅ Şifre başarıyla sıfırlandı!</strong>
                <p class="mb-0 mt-2">Yeni şifrenizle giriş yapabilirsiniz.</p>
            </div>
            <a href="/account/login" class="btn btn-reset mt-3">Giriş Yap</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4">
                    ⚠️ @errorMessage
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleReset">
                <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label class="form-label">📧 Email Adresi</label>
                    <InputText @bind-Value="model.Email" class="form-control" placeholder="ornek@email.com" />
                    <ValidationMessage For="@(() => model.Email)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">🔑 Yeni Şifre</label>
                    <InputText @bind-Value="model.NewPassword" type="password" class="form-control" placeholder="En az 6 karakter" />
                    <ValidationMessage For="@(() => model.NewPassword)" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label">🔑 Şifre Tekrar</label>
                    <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" placeholder="Şifreyi tekrar girin" />
                    @if (!string.IsNullOrEmpty(model.NewPassword) && model.NewPassword != model.ConfirmPassword)
                    {
                        <span class="text-danger small">Şifreler eşleşmiyor</span>
                    }
                </div>

                <button type="submit" class="btn btn-reset" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Sıfırlanıyor...</span>
                    }
                    else
                    {
                        <span>Şifremi Sıfırla</span>
                    }
                </button>
            </EditForm>
        }

        <a href="/account/login" class="back-link">← Giriş sayfasına dön</a>
    </div>
</div>

@code {
    private ResetModel model = new();
    private bool isLoading = false;
    private bool isSuccess = false;
    private string? errorMessage;

    private async Task HandleReset()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "Email adresi gereklidir.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.NewPassword) || model.NewPassword.Length < 6)
        {
            errorMessage = "Şifre en az 6 karakter olmalıdır.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "Şifreler eşleşmiyor.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/reset-password", new
            {
                Email = model.Email,
                NewPassword = model.NewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Message ?? "Şifre sıfırlama başarısız oldu.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ResetModel
    {
        public string Email { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private class ErrorResponse
    {
        public string? Message { get; set; }
    }
}
