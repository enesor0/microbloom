@namespace microbloom.Pages
@page "/job/{JobId:int}"

@using microbloom.DTOs
@using microbloom.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using microbloom.Entities

@inject IJobService JobService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager

<PageTitle>@((jobDetail?.Title ?? "İş İlanı Detayı")) - microbloom</PageTitle>

<div class="job-detail-page">
    <div class="container py-5">
        <!-- Back Button -->
        <div class="mb-4">
            <a href="/jobs" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                </svg>
                <span>İlanlara Dön</span>
            </a>
        </div>

        @if (jobDetail == null)
        {
            <div class="text-center py-5">
                <div class="loading-spinner mb-3"></div>
                <p class="text-muted">İlan detayı yükleniyor...</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Left Column: Job Details -->
                <div class="col-lg-8">
                    <!-- Header Card -->
                    <div class="glass-card mb-4 p-4 p-md-5">
                        <div class="job-header">
                            <h1 class="job-title">@jobDetail.Title</h1>
                            
                            <div class="company-info">
                                <span class="company-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zM7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                        <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3V1z"/>
                                    </svg>
                                </span>
                                <span class="company-name">@jobDetail.CompanyName</span>
                            </div>

                            <div class="job-meta-grid">
                                <div class="meta-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                    </svg>
                                    @jobDetail.Location
                                </div>
                                <div class="meta-item">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                                    </svg>
                                    @jobDetail.PostedDate.ToLongDateString()
                                </div>
                                <div class="meta-badge success">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                    </svg>
                                    Aktif İlan
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description Card -->
                    <div class="glass-card mb-4">
                        <div class="card-section-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h13zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-13z"/>
                                <path d="M3 5.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3 8a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8zm0 2.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5z"/>
                            </svg>
                            <h3>İş Tanımı</h3>
                        </div>
                        <div class="card-content">
                            <div class="job-description-text">
                                @jobDetail.JobDescription
                            </div>
                        </div>
                    </div>

                    <!-- Company Info Card -->
                    <div class="glass-card">
                        <div class="card-section-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zM7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3V1z"/>
                            </svg>
                            <h3>Şirket Hakkında</h3>
                        </div>
                        <div class="card-content">
                            <p class="text-secondary mb-0">@jobDetail.CompanyDescription</p>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Apply Box (Sticky) -->
                <div class="col-lg-4">
                    <AuthorizeView Context="authContext">
                        <Authorized>
                            <div class="glass-card sticky-top" style="top: 100px;">
                                <div class="p-4 text-center">
                                    @if (hasApplied)
                                    {
                                        <div class="success-icon mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                            </svg>
                                        </div>
                                        <h4 class="mb-2 fw-bold text-success">Başvurunuz Alındı!</h4>
                                        <p class="text-muted small">Bu ilana başarıyla başvurdunuz.</p>
                                    }
                                    else
                                    {
                                        <div class="mb-4">
                                            <div class="apply-icon-wrapper mb-3">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5zm-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
                                                </svg>
                                            </div>
                                            <h4 class="mb-2 fw-bold text-primary">Başvuruya Hazır!</h4>
                                            <p class="text-muted small">Merhaba <strong class="text-primary">@authContext.User.Identity?.Name</strong>, kariyerin için harika bir fırsat!</p>
                                        </div>

                                        @if (!string.IsNullOrEmpty(errorMessage))
                                        {
                                            <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                                                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                                </svg>
                                                <span>@errorMessage</span>
                                            </div>
                                        }

                                        <button class="btn btn-primary w-100 btn-lg btn-aurora-glow" 
                                                @onclick="ApplyToJob" 
                                                disabled="@isApplying">
                                            @if (isApplying)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                <span>Başvuru Yapılıyor...</span>
                                            }
                                            else
                                            {
                                                <span>🚀 Hemen Başvur</span>
                                            }
                                        </button>

                                        <p class="small text-muted mt-3 mb-0">
                                            Başvurunuz doğrudan işverene iletilecektir.
                                        </p>
                                    }
                                </div>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                             <div class="glass-card sticky-top" style="top: 100px;">
                                <div class="p-4 text-center">
                                    <div class="mb-4 text-muted opacity-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                                        </svg>
                                    </div>
                                    <h5 class="mb-3 fw-bold">Başvuru İçin Giriş Yapın</h5>
                                    <p class="text-muted small mb-4">Bu ilana başvurmak ve kariyer fırsatlarını yakalamak için üye olmanız gerekmektedir.</p>
                                    
                                    <div class="d-grid gap-2">
                                        <a href="/account/login" class="btn btn-primary btn-aurora-glow">
                                            Giriş Yap
                                        </a>
                                        <a href="/account/register" class="btn btn-outline-primary">
                                            Kayıt Ol
                                        </a>
                                    </div>
                                </div>
                             </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Page Specific Styles */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 500;
        transition: all 150ms ease;
    }
    
    .back-link:hover {
        color: var(--aurora-primary);
        transform: translateX(-3px);
    }

    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-primary);
        border-radius: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    
    [data-theme="dark"] .glass-card {
        background: rgba(30, 41, 59, 0.6);
        border-color: rgba(71, 85, 105, 0.4);
    }

    .job-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
        line-height: 1.2;
        background: var(--gradient-text); 
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent; 
        /* Fallback for browsers */
        color: var(--text-primary);
    }
    
    .company-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }
    
    .company-icon {
        width: 32px;
        height: 32px;
        background: var(--gradient-aurora-soft);
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--aurora-primary);
    }
    
    .company-name {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-primary);    
    }

    .job-meta-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-secondary);
    }
    
    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }
    
    .meta-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.85rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 600;
    }
    
    .meta-badge.success {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .card-section-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border-secondary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--aurora-primary);
    }
    
    .card-section-header h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
    }
    
    .card-content {
        padding: 2rem;
    }
    
    .job-description-text {
        color: var(--text-secondary);
        line-height: 1.8;
        white-space: pre-wrap;
    }

    .apply-icon-wrapper {
        width: 64px;
        height: 64px;
        background: var(--gradient-aurora-soft);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--aurora-primary);
        margin: 0 auto;
    }

    .success-icon {
        color: #10b981;
    }
    
    .btn-aurora-glow {
        box-shadow: 0 4px 15px rgba(0, 66, 37, 0.4); 
        transition: all 0.3s ease;
    }
    
    .btn-aurora-glow:hover:not(:disabled) {
        box-shadow: 0 6px 20px rgba(0, 66, 37, 0.6);
        transform: translateY(-2px);
    }
    
    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid var(--border-primary);
        border-top-color: var(--aurora-primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }
    
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter]
    public int JobId { get; set; }

    private JobPostingDetailDto? jobDetail;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isApplying = false;
    private bool hasApplied = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            jobDetail = await JobService.GetJobByIdAsync(JobId);
        }
        catch (Exception ex)
        {
            errorMessage = $"İlan detayı çekerken hata: {ex.Message}";
        }
    }

    private async Task ApplyToJob()
    {
        try
        {
            isApplying = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/account/login");
                return;
            }

            var appUser = await UserManager.GetUserAsync(user);
            if (appUser == null)
            {
                 errorMessage = "Kullanıcı bilgisi alınamadı.";
                 return;
            }

            await JobService.ApplyForJobAsync(JobId, appUser.Id);

            successMessage = "Başvurunuz başarıyla kaydedildi!";
            hasApplied = true;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("zaten başvuru", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("UNIQUE constraint failed"))
            {
                 hasApplied = true;
                 successMessage = "Bu ilana zaten başvurdunuz.";
            }
            else 
            {
                errorMessage = $"Başvuru yapılamadı: {ex.Message}";
            }
        }
        finally
        {
            isApplying = false;
        }
    }
}
