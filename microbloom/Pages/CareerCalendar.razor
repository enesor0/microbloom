@page "/career-calendar"
@namespace microbloom.Pages

<PageTitle>📅 Kariyer Takvimi - microbloom</PageTitle>

<style>
    .calendar-hero {
        background: linear-gradient(135deg, #004225, #1b4332);
        padding: 4rem 2rem;
        border-radius: var(--radius-2xl);
        margin-bottom: 3rem;
        color: white;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 66, 37, 0.3);
        position: relative;
        overflow: hidden;
    }

    .calendar-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }

    .calendar-hero h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: white !important; position: relative; z-index: 1; }
    .calendar-hero p { color: white !important; position: relative; z-index: 1; }

    .event-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        margin-bottom: 1rem;
        display: flex;
        gap: 1.5rem;
        transition: all 0.3s ease;
    }

    .event-card:hover {
        transform: translateX(5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .event-date {
        min-width: 70px;
        text-align: center;
        padding: 0.5rem;
        border-radius: 12px;
        background: linear-gradient(135deg, #004225, #1b4332);
        color: white;
    }

    .event-day { font-size: 1.8rem; font-weight: 700; line-height: 1; }
    .event-month { font-size: 0.8rem; text-transform: uppercase; }

    .event-content { flex: 1; }
    .event-title { font-weight: 700; color: #1f2937; margin-bottom: 0.25rem; }
    .event-desc { color: #6b7280; font-size: 0.9rem; margin-bottom: 0.5rem; }
    .event-location { color: #004225; font-size: 0.85rem; }
    .event-location i { margin-right: 0.25rem; }

    .event-type {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .type-staj { background: #dbeafe; color: #1d4ed8; }
    .type-fuar { background: #dcfce7; color: #15803d; }
    .type-webinar { background: #fef3c7; color: #d97706; }
    .type-deadline { background: #fee2e2; color: #dc2626; }

    .month-header {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        padding: 1rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        font-weight: 700;
        color: #1f2937;
    }

    .filter-btn {
        padding: 0.5rem 1rem;
        border-radius: 25px;
        border: 2px solid #004225;
        background: white;
        color: #004225;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .filter-btn:hover, .filter-btn.active {
        background: #004225;
        color: white;
    }
</style>

<div class="container my-5">
    <div class="calendar-hero">
        <h1>📅 Kariyer Takvimi</h1>
        <p>Staj başvuruları, kariyer fuarları ve önemli etkinlikler</p>
    </div>

    <!-- Filtreler -->
    <div class="mb-4">
        <button class="btn filter-btn active">Tümü</button>
        <button class="btn filter-btn">🎓 Staj</button>
        <button class="btn filter-btn">🎪 Fuar</button>
        <button class="btn filter-btn">💻 Webinar</button>
        <button class="btn filter-btn">⏰ Son Başvuru</button>
    </div>

    <!-- Ocak -->
    <div class="month-header">📆 Ocak 2025</div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">15</div>
            <div class="event-month">Oca</div>
        </div>
        <div class="event-content">
            <span class="event-type type-staj">Staj</span>
            <h5 class="event-title mt-2">Google STEP Staj Programı - Son Başvuru</h5>
            <p class="event-desc">1. ve 2. sınıf öğrencilere yönelik yazılım mühendisliği staj programı</p>
            <div class="event-location"><i class="bi bi-geo-alt"></i>Uzaktan / ABD</div>
        </div>
    </div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">20</div>
            <div class="event-month">Oca</div>
        </div>
        <div class="event-content">
            <span class="event-type type-webinar">Webinar</span>
            <h5 class="event-title mt-2">CV Yazma Atölyesi</h5>
            <p class="event-desc">İK uzmanlarıyla CV hazırlama ipuçları</p>
            <div class="event-location"><i class="bi bi-camera-video"></i>Online - Zoom</div>
        </div>
    </div>

    <!-- Şubat -->
    <div class="month-header">📆 Şubat 2025</div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">05</div>
            <div class="event-month">Şub</div>
        </div>
        <div class="event-content">
            <span class="event-type type-fuar">Fuar</span>
            <h5 class="event-title mt-2">İTÜ Kariyer Fuarı</h5>
            <p class="event-desc">Türkiye'nin en büyük kariyer fuarlarından biri</p>
            <div class="event-location"><i class="bi bi-geo-alt"></i>İTÜ Ayazağa Kampüsü, İstanbul</div>
        </div>
    </div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">14</div>
            <div class="event-month">Şub</div>
        </div>
        <div class="event-content">
            <span class="event-type type-deadline">Son Başvuru</span>
            <h5 class="event-title mt-2">Microsoft Imagine Cup - Kayıt</h5>
            <p class="event-desc">Öğrenciler için global teknoloji yarışması</p>
            <div class="event-location"><i class="bi bi-globe"></i>Online</div>
        </div>
    </div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">28</div>
            <div class="event-month">Şub</div>
        </div>
        <div class="event-content">
            <span class="event-type type-staj">Staj</span>
            <h5 class="event-title mt-2">Amazon SDE Staj - Son Başvuru</h5>
            <p class="event-desc">Software Development Engineer staj pozisyonları</p>
            <div class="event-location"><i class="bi bi-geo-alt"></i>İstanbul / Dublin</div>
        </div>
    </div>

    <!-- Mart -->
    <div class="month-header">📆 Mart 2025</div>
    <div class="event-card">
        <div class="event-date">
            <div class="event-day">10</div>
            <div class="event-month">Mar</div>
        </div>
        <div class="event-content">
            <span class="event-type type-fuar">Fuar</span>
            <h5 class="event-title mt-2">Boğaziçi Kariyer Günleri</h5>
            <p class="event-desc">100+ şirket ile networking fırsatı</p>
            <div class="event-location"><i class="bi bi-geo-alt"></i>Boğaziçi Üniversitesi, İstanbul</div>
        </div>
    </div>

    <div class="alert alert-success mt-4 border-0" role="alert">
        <i class="bi bi-bell-fill me-2"></i>
        <strong>Hatırlatıcı kur!</strong> Önemli tarihleri kaçırmamak için e-posta bildirimleri alın.
        <button class="btn btn-sm btn-success ms-3">Bildirim Al</button>
    </div>
</div>
